@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "As-Is: Контекстная диаграмма системы управления отоплением «Тёплый дом»"

Person(user, "Пользователь", "Клиент сервиса, управляющий отоплением и просматривающий температуру в доме.")
Person(specialist, "Специалист по подключению", "Выезжает на дом для физической установки, настройки и регистрации реле/датчиков в системе.")

System(monolith, "Монолит «Тёплый дом» (Go)", "Синхронно обрабатывает запросы от пользователей, хранит настройки датчиков и запрашивает их состояние.")

SystemDb_Ext(postgres, "СУБД PostgreSQL", "Хранит конфигурации датчиков (справочник датчиков).")
System_Ext(temp_api, "Внешний API (Temperature API)", "Имитирует внешнее API физических датчиков температуры в комнатах.")

Rel(user, monolith, "Просматривает температуру, включает/выключает отопление", "HTTP/JSON")
Rel(specialist, monolith, "Вручную подключает и регистрирует датчики/реле", "Панель администратора")
Rel(monolith, postgres, "Читает/записывает настройки датчиков", "SQL / pgx")
Rel(monolith, temp_api, "Синхронно запрашивает показания температуры по ID датчика или локации", "HTTP")

@enduml
