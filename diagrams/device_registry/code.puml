@startuml
skinparam packageStyle rect
skinparam roundcorner 5

title "Device Registry Service — Структура кода (C4 Code Diagram)"

package "cmd/device-registry" as cmd_dev_reg {
  class "main.go" as main
}

package internal {
  package config {
    class "Config" as config
  }
  
  package domain {
    package entity {
      class "Device" as device_entity
      class "Hub" as hub_entity
    }
    package repository {
      interface "DeviceRepository" as repo_interface
    }
    package publisher {
      interface "EventPublisher" as pub_interface
    }
  }

  package service {
    class "DeviceService" as device_service
    interface "DeviceUseCase" as usecase_interface
  }

  package delivery {
    package http {
      class "HttpHandler" as http_handler
    }
    package grpc {
      class "GrpcHandler" as grpc_handler
    }
  }

  package infrastructure {
    package db {
      class "PostgresRepository" as postgres_repo
    }
    package kafka {
      class "KafkaPublisher" as kafka_publisher
    }
  }
}

main --> config : "loads config"
main --> http_handler : "registers"
main --> grpc_handler : "registers"

http_handler --> usecase_interface : "calls CRUD operations"
grpc_handler --> usecase_interface : "calls verification"

device_service ..|> usecase_interface : "implements"
device_service --> repo_interface : "reads/writes metadata"
device_service --> pub_interface : "publishes configuration changes"

postgres_repo ..|> repo_interface : "implements"
kafka_publisher ..|> pub_interface : "implements"

device_service --> device_entity : "manages"
device_service --> hub_entity : "manages"

@enduml
